{
  "name": "ask-my-paper",
  "type": "module",
  "version": "1.1.0",
  "description": "Ask My Paper Plugin",
  "config": {
    "addonName": "Ask My Paper",
    "addonID": "ask-my-paper@euclpts.com",
    "addonRef": "askmypaper",
    "addonInstance": "AskMyPaper",
    "prefsPrefix": "extensions.zotero.AskMyPaper",
    "logLevel": "DEBUG"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NakamuraTakumu/Zotero-Gemini-PDF.git"
  },
  "author": "Takumu Nakamura",
  "bugs": {
    "url": "https://github.com/NakamuraTakumu/Zotero-Gemini-PDF/issues"
  },
  "homepage": "https://github.com/NakamuraTakumu/Zotero-Gemini-PDF#readme",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.8.0"
  },
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "tsc --noEmit && zotero-plugin build",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "node test/run.mjs",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@langchain/anthropic": "^1.4.0",
    "@langchain/core": "^1.1.47",
    "@langchain/google": "^0.1.12",
    "@langchain/openai": "^1.4.6",
    "@vscode/markdown-it-katex": "^1.1.2",
    "dompurify": "^3.0.0",
    "katex": "^0.16.0",
    "markdown-it-collapsible": "^2.0.2",
    "markdown-it-container": "^4.0.0",
    "openai": "^6.38.0",
    "uuid": "^13.0.0",
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/dompurify": "^3.0.0",
    "@types/markdown-it": "^13.0.0",
    "@types/markdown-it-container": "^2.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.2.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^5.2.1",
    "copy-webpack-plugin": "^13.0.1",
    "eslint": "^9.32.0",
    "markdown-it": "^14.0.0",
    "mocha": "^11.7.1",
    "prettier": "^3.6.2",
    "ts-loader": "^9.5.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "zotero-plugin-scaffold": "^0.8.0",
    "zotero-types": "^4.1.0-beta.1"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
